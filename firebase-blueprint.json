{
  "entities": {
    "moments": {
      "title": "Moments",
      "description": "Weekly moments, photos, and highlights shared by users",
      "type": "object",
      "properties": {
        "personId": { "type": "string" },
        "weekNumber": { "type": "number" },
        "year": { "type": "number" },
        "weekLabel": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "photos": { "type": "array" },
        "location": { "type": "object" },
        "mood": { "type": "object" },
        "tags": { "type": "array" },
        "reactions": { "type": "object" },
        "comments": { "type": "array" },
        "isHighlight": { "type": "boolean" },
        "audioNote": { "type": "object" },
        "createdAt": { "type": "string" },
        "authorId": { "type": "string" }
      },
      "required": ["personId", "weekNumber", "year", "title", "photos"]
    },
    "people": {
      "title": "People",
      "description": "Contributors and journal authors",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "username": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "accentColor": { "type": "string" },
        "joinedDate": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["name", "username", "avatar"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
