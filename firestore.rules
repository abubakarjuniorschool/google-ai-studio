rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open read and write for community photo journal
    match /moments/{momentId} {
      allow read, write: if true;
    }
    match /people/{personId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
